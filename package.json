{
	"name": "@ballatech/effect-packages",
	"version": "1.0.0",
	"description": "Useful Effect libraries",
	"private": true,
	"scripts": {
		"format": "biome check . --write --vcs-enabled=true --vcs-use-ignore-file=true",
		"lint": "biome check . --vcs-enabled=true --vcs-use-ignore-file=true",
		"test": "vitest --run",
		"test:watch": "vitest --watch",
		"test:compat": "vitest --run -c vitest.config.compat.ts",
		"prepare": "husky",
		"postinstall": "effect-tsgo patch || npx @effect/tsgo patch",
		"lint-staged": "lint-staged",
		"typecheck": "pnpm -r --filter './packages/**' run typecheck",
		"build": "pnpm -r --filter './packages/**' run build",
		"pack:check": "rm -rf .pack && mkdir -p .pack && pnpm -r --filter './packages/**' exec pnpm pack --pack-destination ../../.pack && ls -la .pack",
		"changeset": "changeset",
		"release:version": "changeset version",
		"release:publish": "changeset publish",
		"update": "pnpm dlx taze -r",
		"new": "node ./scripts/new-package.mjs"
	},
	"keywords": [],
	"author": "Krisztian Balla",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"devDependencies": {
		"@ballatech/biome-config": "^1.0.1",
		"@biomejs/biome": "2.5.9",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@effect/tsgo": "^0.36.5",
		"@effect/vitest": "catalog:",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,css,md,json}": [
			"pnpm format --no-errors-on-unmatched",
			"vitest related --run"
		]
	}
}
