{
	"name": "@ballatech/effect-packages",
	"version": "1.0.0",
	"description": "Useful Effect libraries",
	"private": true,
	"scripts": {
		"format": "biome check . --write --vcs-enabled=true --vcs-use-ignore-file=true",
		"lint": "biome check . --vcs-enabled=true --vcs-use-ignore-file=true && pnpm run docs:check",
		"docs:check": "node ./scripts/check-jsdoc.mjs",
		"test": "vitest --run",
		"test:watch": "vitest --watch",
		"test:compat": "vitest --run -c vitest.config.compat.ts",
		"prepare": "lefthook install --force",
		"postinstall": "effect-tsgo patch || npx @effect/tsgo patch",
		"typecheck": "pnpm -r --filter './packages/**' run typecheck",
		"build": "pnpm -r --filter './packages/**' run build",
		"pack:check": "rm -rf .pack && mkdir -p .pack && pnpm -r --filter './packages/**' exec pnpm pack --pack-destination ../../.pack && ls -la .pack",
		"pack:portability": "node ./scripts/check-portability.mjs",
		"changeset": "changeset",
		"release:version": "changeset version",
		"release:publish": "changeset publish",
		"update": "pnpm dlx taze -r",
		"new": "node ./scripts/new-package.mjs"
	},
	"keywords": [],
	"author": "Krisztian Balla",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
	"devDependencies": {
		"@ballatech/biome-config": "^1.0.1",
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@effect/tsgo": "^0.51.1",
		"@effect/vitest": "catalog:",
		"lefthook": "2.2.1",
		"typescript": "7.0.2",
		"vitest": "^5.0.3"
	}
}
