{
	"extends": "../../tsconfigs/tsconfig.lib.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"emitDeclarationOnly": false,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"declarationMap": true,
		"sourceMap": true,
		"lib": ["ES2022", "DOM"],
		"types": []
	},
	"include": ["src"]
}
