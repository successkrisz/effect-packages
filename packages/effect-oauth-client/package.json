{
	"name": "@ballatech/effect-oauth-client",
	"version": "1.0.0",
	"description": "OAuth 2.0 client credentials HttpClient for Effect with token caching and refresh",
	"keywords": [
		"effect",
		"effect-ts",
		"oauth",
		"oauth2",
		"client-credentials",
		"http-client"
	],
	"private": false,
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"effect": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/successkrisz/effect-packages.git",
		"directory": "packages/effect-oauth-client"
	},
	"bugs": {
		"url": "https://github.com/successkrisz/effect-packages/issues"
	},
	"homepage": "https://github.com/successkrisz/effect-packages#readme"
}
