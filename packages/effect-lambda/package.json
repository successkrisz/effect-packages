{
	"name": "effect-lambda",
	"version": "1.0.0-beta.5",
	"description": "Effect-native adapters for AWS Lambda: API Gateway (REST and HTTP APIs), SQS, SNS, DynamoDB Streams and custom authorizers",
	"keywords": [
		"effect",
		"effect-ts",
		"aws",
		"lambda",
		"aws-lambda",
		"api-gateway",
		"sqs",
		"sns",
		"dynamodb",
		"serverless"
	],
	"private": false,
	"license": "MIT",
	"author": {
		"name": "Krisztian Balla",
		"url": "https://github.com/successkrisz",
		"organization": false
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./RestApi": "./src/RestApi.ts",
		"./HttpApi": "./src/HttpApi.ts",
		"./Sns": "./src/Sns.ts",
		"./Sqs": "./src/Sqs.ts",
		"./CustomAuthorizer": "./src/CustomAuthorizer.ts",
		"./DynamoDb": "./src/DynamoDb.ts",
		"./HttpResponse": "./src/HttpResponse.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@ballatech/effect-problem-json": "workspace:*",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"helmet": "^8.1.0"
	},
	"peerDependencies": {
		"@types/aws-lambda": "catalog:",
		"@types/node": "catalog:",
		"effect": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@types/node": {
			"optional": true
		},
		"@types/aws-lambda": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": "./dist/index.js",
			"./RestApi": "./dist/RestApi.js",
			"./HttpApi": "./dist/HttpApi.js",
			"./Sns": "./dist/Sns.js",
			"./Sqs": "./dist/Sqs.js",
			"./CustomAuthorizer": "./dist/CustomAuthorizer.js",
			"./DynamoDb": "./dist/DynamoDb.js",
			"./HttpResponse": "./dist/HttpResponse.js",
			"./package.json": "./package.json"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/successkrisz/effect-packages.git",
		"directory": "packages/effect-lambda"
	},
	"bugs": {
		"url": "https://github.com/successkrisz/effect-packages/issues"
	},
	"homepage": "https://github.com/successkrisz/effect-packages#readme",
	"dependencies": {
		"@types/aws-lambda": "catalog:"
	}
}
