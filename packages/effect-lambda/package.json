{
	"name": "effect-lambda",
	"version": "1.0.0-beta.2",
	"private": false,
	"license": "MIT",
	"author": {
		"name": "Krisztian Balla",
		"url": "https://github.com/successkrisz",
		"organization": false
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./RestApi": "./src/RestApi.ts",
		"./HttpApi": "./src/HttpApi.ts",
		"./Sns": "./src/Sns.ts",
		"./Sqs": "./src/Sqs.ts",
		"./CustomAuthorizer": "./src/CustomAuthorizer.ts",
		"./DynamoDb": "./src/DynamoDb.ts",
		"./HttpResponse": "./src/HttpResponse.ts"
	},
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@ballatech/tsconfig": "catalog:",
		"@effect/language-service": "catalog:",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"helmet": "^8.1.0"
	},
	"peerDependencies": {
		"@types/aws-lambda": "catalog:",
		"@types/node": "catalog:",
		"effect": "catalog:"
	},
	"peerDependenciesMeta": {
		"@types/node": {
			"optional": true
		},
		"@types/aws-lambda": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.js",
			"./RestApi": "./dist/RestApi.js",
			"./HttpApi": "./dist/HttpApi.js",
			"./Sns": "./dist/Sns.js",
			"./Sqs": "./dist/Sqs.js",
			"./CustomAuthorizer": "./dist/CustomAuthorizer.js",
			"./DynamoDb": "./dist/DynamoDb.js",
			"./HttpResponse": "./dist/HttpResponse.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/successkrisz/effect-packages.git",
		"directory": "packages/effect-lambda"
	},
	"bugs": {
		"url": "https://github.com/successkrisz/effect-packages/issues"
	},
	"homepage": "https://github.com/successkrisz/effect-packages#readme",
	"dependencies": {
		"@types/aws-lambda": "catalog:"
	}
}
